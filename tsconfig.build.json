{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "allowJs": true,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "./packages"
  },
  "include": ["packages/**/*.ts", "packages/*/bin/*.js"],
  "exclude": ["**/node_modules", "packages/adapter-pi"]
}
