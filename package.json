{
  "name": "arlo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": "24.13.1"
  },
  "scripts": {
    "build:generic": "node scripts/generic-delivery.mjs build",
    "test:generic": "node scripts/generic-delivery.mjs verify",
    "build": "node scripts/delivery.mjs build",
    "test:delivery": "node scripts/delivery.mjs verify",
    "build:web": "node scripts/web-delivery.mjs build",
    "build:pi": "node scripts/pi-delivery.mjs build",
    "test:web": "node web/run.mjs",
    "typecheck:web": "node web/typecheck.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.pi.json --noEmit",
    "test:acceptance": "node acceptance/run.mjs",
    "compatibility": "node scripts/compatibility.mjs",
    "test:pi": "node --test --test-concurrency=1 pi-acceptance/*.test.mjs",
    "test": "node probes/run.mjs",
    "test:host": "node probes/run.mjs probes/host.test.ts probes/pending.test.ts probes/history-reader.test.ts probes/isolation.test.ts probes/network-denied.test.ts",
    "test:host:installed": "node probes/run-desktop-host.mjs",
    "test:transport": "node probes/run.mjs probes/mcp-notification.test.ts probes/mcp-metadata.test.ts probes/host-reception-gate.test.ts probes/transport-retry-defense.test.ts probes/transport-tls.test.ts probes/secure-transport.test.ts",
    "test:transport:installed": "node probes/run-desktop-transport.mjs",
    "test:transport:all": "node probes/run-transport-probes.mjs",
    "test:daemon": "node scripts/test-daemon.mjs",
    "test:all": "node probes/run.mjs && node scripts/test-daemon.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "@deepseek-ai/dsh-session-format@0.2.0-rc.2": "packages/adapter-dsh/patches/dsh-session-format@0.2.0-rc.2.patch"
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2",
    "@arlo/adapter-sdk": "workspace:*",
    "@arlo/daemon": "workspace:*",
    "@arlo/adapter-dsh": "workspace:*",
    "@arlo/sdk": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0"
}
