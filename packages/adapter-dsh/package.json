{
  "name": "@arlo/adapter-dsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.1 || 24.13.1 || 24.15.0 || 24.22.1"
  },
  "exports": {
    ".": {
      "types": "./host.d.mts",
      "default": "./host.mjs"
    },
    "./runtime": "./src/runtime.ts",
    "./client": {
      "types": "./client.d.cts",
      "default": "./client.cjs"
    },
    "./delivery": {
      "types": "./delivery/index.d.mts",
      "default": "./delivery/index.mjs"
    }
  },
  "dependencies": {
    "@arlo/adapter-sdk": "workspace:*",
    "@arlo/daemon": "workspace:*",
    "@arlo/sdk": "workspace:*",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "files": [
    "src",
    "host.mjs",
    "host.d.mts",
    "host-types.d.mts",
    "client.cjs",
    "client.d.cts",
    "client-types.d.cts",
    "tsconfig.host.json",
    "tsconfig.client.json",
    "cordis.patch.yml",
    "delivery",
    "patches",
    "host-create.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "license": "Apache-2.0"
}
